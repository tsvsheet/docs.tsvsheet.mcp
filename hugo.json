{
  "baseURL": "https://tsvsheet.github.io/docs.tsvsheet.mcp/",
  "title": "tsvsheet.mcp",
  "publishDir": "_site",
  "enableRobotsTXT": true,
  "markup": {
    "goldmark": {
      "renderHooks": {
        "link": {
          "useEmbedded": "fallback"
        },
        "image": {
          "useEmbedded": "fallback"
        }
      }
    }
  },
  "params": {
    "description": "The tsvsheet MCP server — compute, check, and render .tsvt spreadsheets from AI agents.",
    "mainSite": "https://tsvsheet.com"
  },
  "disableKinds": [
    "taxonomy",
    "term"
  ],
  "module": {
    "imports": [
      {
        "path": "github.com/tsvsheet/theme.tsvsheet"
      }
    ]
  }
}
